/ {
    zephyr,user {
        io-channels = <&adc0 0>; // creating c ref 2 dev adc0 chann 0
    };
};

&adc0 {
    #address-cells = <1>; // addressing by only 1 num
    #size-cells = <0>; // size of 0 because channels arent memory mapped
    status = "okay";

    channel@0 {
        reg = <0>; // reg is the channel number
        zephyr,gain = "ADC_GAIN_1_6";	// gain of 1/6 for the ADC
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};
